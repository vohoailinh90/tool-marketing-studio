# Secrets: API keys and Page tokens live only here, never in YAML or git.
.env
.env.*
!.env.example

# Local state: smoke-check result, publish lock, cached webfonts, HTML build pages.
.studio/
.fonts/
build/

# People's words and personal data stay out of git: raw survey exports, scanned comments.
research/raw/
campaigns/*/feedback/

# Regenerated on demand.
campaigns/*/packs/
*.part

# Python / Node.
__pycache__/
*.pyc
.pytest_cache/
web/node_modules/
web/node_modules/.tmp/
# Generated artifacts (keep folders, ignore run outputs)
artifacts/architecture/*
!artifacts/architecture/.gitkeep
artifacts/critiques/*
!artifacts/critiques/.gitkeep
artifacts/plans/*
!artifacts/plans/.gitkeep
artifacts/reviews/*
!artifacts/reviews/.gitkeep

# Session handoff is local session state, not repository content:
# it quotes the last prompt and the working tree of one machine's run.
artifacts/handoff/*
!artifacts/handoff/.gitkeep

