      {"id": "delivery", "color": "violet", "agents": ["implementer"]},
      {"id": "verification", "color": "magenta", "agents": ["code-reviewer", "code-reviewer-t3", "test-engineer", "code-reviewer-verify"]}
    ],
    "other_lane": {"id": "other", "color": "slate"},
