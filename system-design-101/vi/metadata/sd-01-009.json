  "claims": [
    {
      "claim_vi": "HTTP2 multiplex nhiều trao đổi trên một kết nối bằng frames/streams.",
      "source": "https://developer.mozilla.org/en-US/docs/Glossary/HTTP_2"
    },
    {
      "claim_vi": "TCP HOL vẫn tồn tại; header block không xen kẽ tùy ý; mô hình priority cũ deprecated, push có thể tắt.",
      "source": "https://www.rfc-editor.org/rfc/rfc9113.html",
      "section": "§1,§4.3,§5.3,§6.5.2,§8.4"
    },
    {
      "claim_vi": "HPACK nén header bằng bảng/mã hóa, khác nén body.",
      "source": "https://www.rfc-editor.org/rfc/rfc7541.html",
      "section": "§1–2"
    },
    {
      "claim_vi": "RFC9218 định nghĩa tín hiệu ưu tiên mới.",
      "source": "https://www.rfc-editor.org/rfc/rfc9218.html",
      "section": "§1"
    }
  ],
  "design_notes_vi": "Hình mới DATA frames stream1/3; so sánh một kết nối, không phủ nhận parallel HTTP1.1.",
  "source_deviations": [
    "Không coi HTTP2 luôn nhanh hơn hoặc binary frames luôn làm body nhỏ hơn.",
    "Ưu tiên weight/dependency nguồn là model cũ deprecated; push không là mặc định client nào cũng bật."
  ],
