      {"id": "build", "color": "orange", "agents": ["tester", "coder"]},
      {"id": "review", "color": "violet", "agents": ["reviewer"]},
      {"id": "scripts", "color": "slate", "agents": ["gates", "pack"]}
    ],
    "agents": {
      "claude-spec": {},
      "claude-audit": {"mode": "reviewing"},
      "tester": {},
      "coder": {},
      "reviewer": {"mode": "reviewing"},
      "gates": {"kind": "script"},
      "pack": {"kind": "script"}
    }
  }
